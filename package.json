{
  "name": "inventario-app",
  "version": "1.0.0",
  "main": "index.tsx",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.0.0",
    "lucide-react-native": "^1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "pnpm expo export --platform web && node -e \"const fs=require('fs'); let h=fs.readFileSync('dist/index.html','utf8'); if(!h.includes('manifest.json')){ h=h.replace('</head>','<link rel=\\\"manifest\\\" href=\\\"/manifest.json\\\"><link rel=\\\"apple-touch-icon\\\" href=\\\"/icon-192.png\\\"></head>'); fs.writeFileSync('dist/index.html',h); }\""
  },
  "private": true,
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
